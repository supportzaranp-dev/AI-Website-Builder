# Postgres connection string (Neon se copy karo -> https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxxx.aws.neon.tech/dbname?sslmode=require"

# NextAuth secret - koi bhi random long string (openssl rand -base64 32)
AUTH_SECRET="change-this-to-a-long-random-secret-string"

# OpenRouter free API key -> https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx"

# Default free model (aap change kar sakte ho admin panel se bhi)
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Aapke app ka URL (local ke liye yahi rehne do)
NEXTAUTH_URL="http://localhost:3000"
